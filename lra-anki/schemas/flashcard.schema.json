{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LRA Flashcard CSV Row",
  "type": "object",
  "required": ["Front", "Back", "Tags"],
  "additionalProperties": false,
  "properties": {
    "Front": {
      "type": "string",
      "minLength": 1
    },
    "Back": {
      "type": "string",
      "minLength": 1
    },
    "Tags": {
      "type": "string",
      "minLength": 1
    }
  }
}
